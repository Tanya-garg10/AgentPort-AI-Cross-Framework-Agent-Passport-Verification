{
  "name": "agent_status",
  "description": "Retrieves real-time operational status, active role assignment, and framework visa standings for the agent.",
  "permission_level": "auditor",
  "input_schema": {
    "type": "object",
    "properties": {
      "include_telemetry": {
        "type": "boolean",
        "description": "Whether to include high-resolution verification telemetry"
      },
      "framework_filter": {
        "type": "string",
        "enum": ["all", "openai", "crewai", "claude_code", "lyzr"],
        "description": "Filter visa state by specific framework"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "agent_name": { "type": "string" },
      "version": { "type": "string" },
      "passport_status": { "type": "string", "enum": ["VALID", "EXPIRED", "REVOKED", "PENDING"] },
      "composite_score": { "type": "number" },
      "active_visas": {
        "type": "array",
        "items": { "type": "string" }
      },
      "last_verified_at": { "type": "string" }
    },
    "required": ["agent_name", "version", "passport_status", "composite_score", "active_visas"]
  }
}
